{{!--
    Selectize Property Input
    ========================

    `charcoal/admin/property/input/selectize`
--}}

{{# inputGroup }}
    <div class="input-group">
{{/ inputGroup }}
{{# isObject }}
    {{> charcoal/admin/property/control/select }}
{{/ isObject }}
{{^ isObject }}
        <input
            type="text"
            id="{{ inputId }}"
            name="{{ inputName }}"
            class="form-control {{ inputClass }}"
            value="{{ inputVal }}"
            {{# placeholder }}placeholder="{{ . }}"{{/ placeholder }}
            {{# readOnly }}readonly{{/ readOnly }}
            {{# required }}required{{/ required }}
            {{# disabled }}disabled{{/ disabled }}
        >
{{/ isObject }}
{{# inputGroup }}
        <span class="input-group-append">
    {{# allowClipboardCopy }}
        <button type="button"
                id="{{ inputId }}_copy"
                class="btn btn-outline-secondary"
                data-clipboard-target="#{{ inputId }}">
            <span class="fa fa-copy" aria-hidden="true"></span>
            <span class="sr-only">{{# _t }}Copy To Clipboard{{/ _t }}</span>
        </button>
    {{/ allowClipboardCopy }}
    {{# allowPreview }}
        <a
            id="{{ inputId }}_preview"
            class="btn btn-lg btn-outline-secondary disabled"
            data-update-target="#{{ inputId }}"
            target="_blank"
        >
            <span class="fa fa-external-link" aria-hidden="true"></span>
            <span class="sr-only">Voir</span>
        </a>
    {{/ allowPreview }}
    {{# allowUpdate }}
        <button type="button"
                id="{{ inputId }}_update"
                class="btn btn-lg btn-outline-secondary"
                data-update-target="#{{ inputId }}">
            <span class="fa fa-pencil" aria-hidden="true"></span>
            <span class="sr-only">{{# _t }}Update selected item{{/ _t }}</span>
        </button>
    {{/ allowUpdate }}
    {{# allowCreate }}
        <button type="button"
                id="{{ inputId }}_create"
                class="btn btn-lg btn-outline-secondary"
                data-update-target="#{{ inputId }}">
            <span class="fa fa-plus" aria-hidden="true"></span>
            <span class="sr-only">{{# _t }}Create a new item{{/ _t }}</span>
        </button>
    {{/ allowCreate }}
    </span>
    </div>
{{/ inputGroup }}